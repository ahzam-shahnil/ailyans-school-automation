# Supabase project credentials
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_<...>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<...>

# Sync service account (Supabase Auth user, created in Dashboard)
# This is NOT the same as your app's local Users table.
SUPABASE_SYNC_EMAIL=sync@ailyans.local
SUPABASE_SYNC_PASSWORD=<strong-random-password>
