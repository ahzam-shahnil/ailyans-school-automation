  "cards": [
    {
      "dot": "cyan",
      "title": "Presentation & Host Isolation",
      "items": [
        "Flutter desktop shell hosted via window_manager with a 1024x680 minimum window constraint",
        "Consistent AppShell coordinates navigation, active session top-bar, and module breadcrumbs"
      ]
    },
    {
      "dot": "rose",
      "title": "Authentication & RBAC Trust Boundary",
      "items": [
        "GoRouter acts as the central security guard checking UserSession and granular object IDs (AccRhts)",
        "BCrypt password hashing and user level checks isolate administrative modules like System Settings"
      ]
    },
    {
      "dot": "emerald",
      "title": "State & Data Persistence",
      "items": [
        "Riverpod StateNotifiers encapsulate UI mutations and mediate transactions through repositories",
        "DatabaseService enforces SQLite foreign keys and automatic user_version schema migrations"
      ]
    },
    {
      "dot": "amber",
      "title": "Offline Storage & Safety Lifecycle",
      "items": [
        "Student photo repository and timestamped SQLite backups live in Documents/Ailyans directory",
        "BackupService runs pre-restore schema integrity checks and atomic file swaps for disaster recovery"
      ]
    }
  ]
}
